# Generated by _build/build.py - edit _build/content/redirects.json instead
Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html
ErrorDocument 410 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Private build files are never served
RewriteRule ^(_build|\.git|data)(/|$) - [F,L,NC]

# Gone for good (junk URLs from old platforms)
RewriteRule ^api/ - [G,L]
RewriteRule ^regform/ - [G,L]
RewriteRule ^src/main/ - [G,L]
RewriteRule ^universal/ - [G,L]
RewriteRule ^kapag-tamad-ka-nga-naman/?$ - [G,L]

# Old pages merged into one canonical page (one hop, straight to https + main host)
RewriteRule ^aboutus/?$ https://woodenspoonfreezery.com/about/ [R=301,L,NC]
RewriteRule ^press/?$ https://woodenspoonfreezery.com/about/ [R=301,L,NC]
RewriteRule ^ws\-labs/?$ https://woodenspoonfreezery.com/our-process/ [R=301,L,NC]
RewriteRule ^faqs/?$ https://woodenspoonfreezery.com/questions/ [R=301,L,NC]
RewriteRule ^faqs\-1/?$ https://woodenspoonfreezery.com/questions/ [R=301,L,NC]
RewriteRule ^shipping\-information/?$ https://woodenspoonfreezery.com/questions/ [R=301,L,NC]
RewriteRule ^where\-to\-buy/?$ https://woodenspoonfreezery.com/stockists/ [R=301,L,NC]
RewriteRule ^contact\-us/?$ https://woodenspoonfreezery.com/contact/ [R=301,L,NC]
RewriteRule ^contact\-us\-2/?$ https://woodenspoonfreezery.com/contact/ [R=301,L,NC]
RewriteRule ^ws\-trailer/?$ https://woodenspoonfreezery.com/trailer/ [R=301,L,NC]
RewriteRule ^fows/?$ https://woodenspoonfreezery.com/loyalty/ [R=301,L,NC]
RewriteRule ^buy/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^membership/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^mini\-membership\-flavours/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^membership_signup/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^howitworks/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^joinus/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/the\-original\-party\-pack/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/party\-pack\-2\-pack/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/party\-pack\-4\-pack\-6t4jb\-f3r4r/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/cookies\-amp\-ice\-cream\-pack/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/ut144mn8yag1cnfh0fwb68rebyz3uv/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/gift\-card/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/27qtfg5k0revdmja8crmvtm99zw3bh/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^shop/pie\-amp\-ice\-cream\-pack\-sm/?$ https://woodenspoonfreezery.com/shop/ [R=301,L,NC]
RewriteRule ^ourproducts/?$ https://woodenspoonfreezery.com/flavours-1/ [R=301,L,NC]
RewriteRule ^flavours/?$ https://woodenspoonfreezery.com/flavours-1/ [R=301,L,NC]
RewriteRule ^limited\-edition\-flavours/?$ https://woodenspoonfreezery.com/limited-edition/ [R=301,L,NC]
RewriteRule ^sig\-fla/?$ https://woodenspoonfreezery.com/signature-flavours/ [R=301,L,NC]
RewriteRule ^sig\-fla/author\-55dfe695e4b05f7afaa86fd6/?$ https://woodenspoonfreezery.com/signature-flavours/ [R=301,L,NC]
RewriteRule ^gallery\-l/?$ https://woodenspoonfreezery.com/limited-edition/ [R=301,L,NC]
RewriteRule ^gallery\-l/author\-55dfe695e4b05f7afaa86fd6/?$ https://woodenspoonfreezery.com/limited-edition/ [R=301,L,NC]
RewriteRule ^collaborations/?$ https://woodenspoonfreezery.com/freezecraft/ [R=301,L,NC]
RewriteRule ^ic\-sandwiches/?$ https://woodenspoonfreezery.com/cookie-sandwiches/ [R=301,L,NC]
RewriteRule ^cookies/?$ https://woodenspoonfreezery.com/cookie-sandwiches/ [R=301,L,NC]
RewriteRule ^cookies/author\-55dfe695e4b05f7afaa86fd6/?$ https://woodenspoonfreezery.com/cookie-sandwiches/ [R=301,L,NC]
RewriteRule ^giveaway/?$ https://woodenspoonfreezery.com/ [R=301,L,NC]
RewriteRule ^cart/?$ https://woodenspoonfreezery.com/ [R=301,L,NC]
RewriteRule ^search/?$ https://woodenspoonfreezery.com/ [R=301,L,NC]
RewriteRule ^feed/?$ https://woodenspoonfreezery.com/feed.xml [R=301,L,NC]
RewriteRule ^gallery-l/[a-z0-9]+/?$ https://woodenspoonfreezery.com/limited-edition/ [R=301,L,NC]
RewriteRule ^cookies/[a-z0-9]+/?$ https://woodenspoonfreezery.com/cookie-sandwiches/ [R=301,L,NC]

# index.html and .html requests -> clean URL with trailing slash
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://woodenspoonfreezery.com/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
RewriteCond %1 !^404$
RewriteRule ^ https://woodenspoonfreezery.com/%1/ [R=301,L]

# www -> main host
RewriteCond %{HTTP_HOST} ^www\.woodenspoonfreezery\.com$ [NC]
RewriteRule ^(.*)$ https://woodenspoonfreezery.com/$1 [R=301,L]

# Missing trailing slash on a page -> add it
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+[^/])$ https://woodenspoonfreezery.com/$1/ [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+[^/])$ https://woodenspoonfreezery.com/$1/ [R=301,L]

# Clean URL -> file.html (internal)
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
<FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|gif|ico|svg)$">
Header set Cache-Control "public, max-age=2592000"
</FilesMatch>
<FilesMatch "\.(html|xml)$">
Header set Cache-Control "public, max-age=600"
</FilesMatch>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_mime.c>
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
</IfModule>
